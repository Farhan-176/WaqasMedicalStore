# Waqas Medical Store - Production Environment Configuration Template
# Ensure hosting platforms (Vercel / Render) have these environment keys set securely!

# 1. Environment Mode & Container Port
NODE_ENV=production
PORT=5000

# 2. MongoDB Production URI (MongoDB Atlas Cluster with SSL)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/waqas_medical_store?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/waqas_medical_store?retryWrites=true&w=majority

# 3. JSON Web Token Secret (Generate a strong 64-character random string for production!)
# Example command: openssl rand -base64 48
JWT_SECRET=generate_64_character_random_secret_token_string_for_production_use

# 4. Client API Target & Allowed CORS Origins
VITE_API_URL=https://waqas-medical-backend.onrender.com
CORS_ORIGIN=https://waqasmedicalstore.vercel.app

# 5. Encrypted Cloud Storage Credentials (For Prescription Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
AWS_S3_BUCKET=your_encrypted_s3_bucket_name
